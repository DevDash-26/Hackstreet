NODE_ENV=development
PORT=4000

# Live AI assistant (optional). Leave AI_API_KEY empty to keep the frontend's
# canned mock fallback. Any OpenAI-compatible endpoint works (Groq, OpenAI,
# Google Gemini in OpenAI mode, Ollama, LM Studio...).
AI_API_KEY=
AI_PROVIDER_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=15000